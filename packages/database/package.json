{
  "name": "@abhyas/database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./attempts": "./src/repositories/drizzle-attempts.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/migration/seed-from-files.ts"
  },
  "dependencies": {
    "@abhyas/content": "workspace:*",
    "@abhyas/quiz-engine": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "@types/pg": "^8.11.10"
  }
}
